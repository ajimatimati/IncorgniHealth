# IncorgniHealth Client — Environment Variables
# Copy this file to .env and fill in the values before running.
# DO NOT commit the real .env file to version control.

# ── API ───────────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3001/api/v1

# ── Google OAuth ──────────────────────────────────────────────────────────────
# OAuth 2.0 Web Client ID from Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID

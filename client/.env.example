# IncorgniHealth Client — Environment Variables
# Copy this file to .env and fill in the values before running.
# DO NOT commit the real .env file to version control.

# ── API ───────────────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT:
VITE_API_URL=http://localhost:3001/api/v1

# PRODUCTION (Vercel):
# After deploying the backend to Vercel, set this to your Vercel app URL:
# VITE_API_URL=https://YOUR-APP-NAME.vercel.app/api/v1
#
# IMPORTANT: This value is baked into the build at `npm run build` time.
# If you change it, you must rebuild and redeploy the frontend to Firebase.

# ── Supabase Realtime ─────────────────────────────────────────────────────────
# Required for real-time chat, WebRTC video signaling, and waiting room.
# Get these from: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE_ME

# ── Google OAuth ──────────────────────────────────────────────────────────────
# OAuth 2.0 Web Client ID from Google Cloud Console.
# Add both your Firebase Hosting URL and localhost to the Authorized JavaScript
# Origins in GCP Console for OAuth to work in both dev and production.
VITE_GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID

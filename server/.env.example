# IncogniCare Server — Environment Variables
# Copy this file to .env and fill in the values before running.
# DO NOT commit the real .env file to version control.
#
# ═══════════════════════════════════════════════════════════════════════════════
# DEPLOYMENT GUIDE (Hybrid Free Stack)
# ─────────────────────────────────────
# Backend:   Vercel Serverless Functions (free, stateless, auto-scales)
# Database:  Supabase (free 500MB PostgreSQL, no 30-day expiration)
# Realtime:  Supabase Realtime (free, handles WebRTC signaling + chat)
# Frontend:  Firebase Hosting (free 10GB, global CDN)
#
# Set the env vars below in Vercel's "Environment Variables" dashboard panel.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────────────
# LOCAL:
DATABASE_URL="postgresql://user:password@localhost:5432/mcnuels?schema=public"
#
# PRODUCTION (Supabase):
# Go to Supabase Dashboard → Settings → Database → Connection string (URI).
# Use the "Transaction" pooler URL for Prisma:
# DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# Also set DIRECT_URL for Prisma Migrate (non-pooled):
# DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ── Auth ──────────────────────────────────────────────────────────────────────
# Secret key for JWT signing. Use a strong random 64-char string in production.
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_STRING
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_LONG_RANDOM_STRING

# ── CORS ──────────────────────────────────────────────────────────────────────
# PRODUCTION: Set to your Firebase Hosting URL. Comma-separate for multiple.
# Example: https://your-project.web.app,https://your-project.firebaseapp.com
CORS_ORIGIN=http://localhost:5174

# ── Payment Gateway ───────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_REPLACE_WITH_PAYSTACK_KEY

# ── AI Route ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-REPLACE_WITH_OPENAI_KEY

# ── App ───────────────────────────────────────────────────────────────────────
# Vercel sets IS_VERCEL=true and NODE_ENV=production automatically via vercel.json.
# No need to set PORT on Vercel—it is managed by the platform.
PORT=3001
NODE_ENV=development

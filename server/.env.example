# IncorgniHealth Server — Environment Variables
# Copy this file to .env and fill in the values before running.
# DO NOT commit the real .env file to version control.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/mcnuels?schema=public"

# ── Auth ──────────────────────────────────────────────────────────────────────
# Secret key for JWT signing. Use a strong random 64-char string in production.
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_STRING
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_LONG_RANDOM_STRING

# ── CORS ──────────────────────────────────────────────────────────────────────
# Set to the production frontend URL. REQUIRED in production.
CORS_ORIGIN=http://localhost:5174

# ── Payment Gateway ───────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_REPLACE_WITH_PAYSTACK_KEY

# ── AI Route ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-REPLACE_WITH_OPENAI_KEY

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
